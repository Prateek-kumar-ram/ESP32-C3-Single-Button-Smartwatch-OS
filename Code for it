void setOLEDContrast(int value) {
  currentBrightness = value; 
  u8g2.setContrast(value);   
}

void loadPreferences() {
  prefs.begin("watch", false);
  isAODEnabled = prefs.getBool("aod", false); 
  maxBrightness = prefs.getInt("bright", 255);
  aodBrightness = prefs.getInt("aodbright", 1); 
  displayTimeoutMs = prefs.getInt("timeout", 10) * 1000;
  prefs.end();
}

int getBatteryPercentage() {
  int rawADC = analogRead(BATTERY_ADC_PIN);
  float voltage = (rawADC / 4095.0) * 3.3 * 2.0; 
  int percent = map(voltage * 100, 330, 420, 0, 100);
  percent = constrain(percent, 0, 100);

  // Initialize instantly on first read to avoid -1 bug
  if (displayedBatteryPct == -1) {
    displayedBatteryPct = percent;
  } else {
    // Standard Anti-Fluctuation Logic (No charging screen overlay)
    if (percent < displayedBatteryPct) displayedBatteryPct = percent; 
    else if (percent >= displayedBatteryPct + 5) displayedBatteryPct = percent; 
  }
  return displayedBatteryPct;
}

void loadTextLines(int startLine = 0) {
  File file = LittleFS.open("/notes.txt", "r");
  if (!file) { textViewerContent[0] = "Vault Empty."; textViewerContent[1] = ""; textViewerContent[2] = ""; return; }
  
  int current = 0;
  while (file.available() && current < startLine) { file.readStringUntil('\n'); current++; }

  for (int i = 0; i < 3; i++) {
    if (file.available()) {
      textViewerContent[i] = file.readStringUntil('\n');
      textViewerContent[i].replace("\r", ""); 
    } else {
      textViewerContent[i] = ""; 
      // Loop back to start if we hit the end
      if (i == 0) { currentTextLine = 0; file.seek(0); return loadTextLines(0); }
    }
  }
  file.close();
}

void toggleWiFiPortal(bool enable) {
  if (enable) {
    isWiFiActive = true;
    wifiEmptyStartTime = millis(); 
    WiFi.mode(WIFI_AP); 
    WiFi.softAP("C3_Mini_Watch", "12345678");
    
    server.on("/", [](){ server.send(200, "text/html", htmlDashboard); });
    server.on("/shutdown", [](){ server.send(200); wifiShutdownRequested = true; });
    server.on("/status", [](){
      char json[64];
      snprintf(json, sizeof(json), "{\"batt\":%d, \"temp\":%d}", getBatteryPercentage(), (int)temperatureRead());
      server.send(200, "application/json", json);
    });
    
    
    server.on("/upload", HTTP_POST, [](){ server.send(200); loadTextLines(0); }, [](){
      HTTPUpload& upload = server.upload();
      if (upload.status == UPLOAD_FILE_START) LittleFS.open("/notes.txt", "w").close();
      else if (upload.status == UPLOAD_FILE_WRITE) { File f = LittleFS.open("/notes.txt", "a"); f.write(upload.buf, upload.currentSize); f.close(); }
    });

    server.on("/save", HTTP_POST, [](){
      prefs.begin("watch", false);
      prefs.putBool("aod", server.arg("aod") == "1");
      prefs.putInt("bright", server.arg("bright").toInt());
      prefs.putInt("aodbright", server.arg("aodbright").toInt());
      prefs.putInt("timeout", server.arg("timeout").toInt());
      prefs.end();
      loadPreferences();
      setOLEDContrast(maxBrightness);
      isScreenDimmed = false;
      server.send(200, "text/html", "<body style='background:#121212; color:white; text-align:center;'><h3>Saved!</h3><a href='/' style='color:#00ADB5;'>Go Back</a></body>");
    });
    server.on("/settime", [](){
      struct tm t = {0};
      t.tm_hour = server.arg("h").toInt(); t.tm_min = server.arg("m").toInt(); t.tm_sec = server.arg("s").toInt();
      t.tm_year = server.arg("y").toInt() - 1900; t.tm_mon = server.arg("mo").toInt() - 1;
      t.tm_mday = server.arg("da").toInt(); t.tm_wday = server.arg("wd").toInt();
      struct timeval tv = { mktime(&t), 0 }; settimeofday(&tv, NULL);
      server.send(200, "text/plain", "OK");
    });
    server.begin();
  } else {
    isWiFiActive = false;
    server.stop();
    WiFi.softAPdisconnect(true); 
    WiFi.mode(WIFI_OFF);
  }
}

