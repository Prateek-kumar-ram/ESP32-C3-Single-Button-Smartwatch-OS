void setup() {
  pinMode(BUTTON_PIN, INPUT_PULLUP);
  loadPreferences();
  LittleFS.begin(true);
  
  u8g2.begin();
  u8g2.setPowerSave(0); 
  setOLEDContrast(maxBrightness);

  struct tm timeinfo;
  getLocalTime(&timeinfo, 100);
  if (timeinfo.tm_year < 120) {
    struct tm fakeTime = {0};
    fakeTime.tm_hour = 12; fakeTime.tm_mday = 1; fakeTime.tm_year = 124; 
    struct timeval tv = { mktime(&fakeTime), 0 };
    settimeofday(&tv, NULL);
  }

  // Get raw battery voltage early for accurate random seeding
  int rawADC = analogRead(BATTERY_ADC_PIN);
  randomSeed(rawADC + micros());

  // Force first battery read on boot to fix -1 bug
  getBatteryPercentage();

  if (esp_sleep_get_wakeup_cause() == ESP_SLEEP_WAKEUP_GPIO) {
    fakeSteps += random(15, 45); 
  }

  esp_deep_sleep_enable_gpio_wakeup((1ULL << BUTTON_PIN), ESP_GPIO_WAKEUP_GPIO_LOW);
  lastActivityTime = millis();
}

void loop() {
  unsigned long currentMillis = millis();

  if (wifiShutdownRequested) {
    wifiShutdownRequested = false;
    toggleWiFiPortal(false);
  }

  if (isWiFiActive) {
    server.handleClient();
    if (WiFi.softAPgetStationNum() > 0) {
      wifiEmptyStartTime = currentMillis; 
    } else if (currentMillis - wifiEmptyStartTime > 60000) {
      toggleWiFiPortal(false);
      lastActivityTime = currentMillis; 
    }
  }

  bool buttonState = !digitalRead(BUTTON_PIN);
  
  if (buttonState && !buttonHeld) {
    buttonPressTime = currentMillis;
    buttonHeld = true;
    longPressHandled = false; 
    
    if (isScreenDimmed) {
      setOLEDContrast(maxBrightness); 
      isScreenDimmed = false;
      lastActivityTime = currentMillis;
      ignoreNextRelease = true; 
      fakeSteps += random(15, 45); 
    }
  }

  if (buttonState && buttonHeld && !longPressHandled) {
    if (currentMillis - buttonPressTime >= 2000) {
      longPressHandled = true; 
      lastActivityTime = currentMillis;
      pendingClick = false; 

      if (isWiFiActive) {
        // Holding while WiFi is on instantly turns it off!
        toggleWiFiPortal(false);
      } else {
        if (currentScreen == SCREEN_GAME || currentScreen == SCREEN_COIN || currentScreen == SCREEN_STOPWATCH || currentScreen == SCREEN_TEXT) {
          gameActive = false; coinActive = false; textActive = false;
          currentScreen = SCREEN_HOME; // Exit Apps
        } else if (currentScreen == SCREEN_STATUS) {
          if (!isEditingAOD) {
            isEditingAOD = true; 
          } else {
            isEditingAOD = false;
            showDoneMessage = true;
            doneMessageTime = currentMillis;
            prefs.begin("watch", false);
            prefs.putBool("aod", isAODEnabled);
            prefs.end();
          }
        } else {
          toggleWiFiPortal(true); // Turn ON WiFi
        }
      }
    }
  }
  
  if (!buttonState && buttonHeld) {
    buttonHeld = false;
    lastActivityTime = currentMillis;
    
    if (!longPressHandled) {
      if (ignoreNextRelease) {
        ignoreNextRelease = false;
      } else {
        // Double Click Lag ONLY applies if we need it
        bool needsLag = (currentScreen == SCREEN_GAME && !gameActive) || 
                        (currentScreen == SCREEN_COIN && !coinActive) || 
                        (currentScreen == SCREEN_STOPWATCH && !swRunning) || 
                        (currentScreen == SCREEN_TEXT && !textActive);

        if (needsLag) {
          if (currentMillis - lastButtonReleaseTime < 300 && pendingClick) {
            clickCount = 2; // Confirmed Double Click
            pendingClick = false; lastButtonReleaseTime = 0; 
          } else {
            pendingClick = true; lastButtonReleaseTime = currentMillis;
          }
        } else {
          clickCount = 1; // Instant single click!
          lastButtonReleaseTime = currentMillis;
        }
      }
    }
  }

  // Timer to confirm single click if lag was applied
  if (pendingClick && (currentMillis - lastButtonReleaseTime > 300)) {
    clickCount = 1;
    pendingClick = false;
  }

  if (clickCount > 0) {
    if (clickCount == 2) {
      // --- DOUBLE CLICK EVENT ---
      if (currentScreen == SCREEN_GAME && !gameActive) {
        gameActive = true; gameOver = false; score = 0; cactusX = 128; dinoY = 38; dinoVy = 0;
      } else if (currentScreen == SCREEN_COIN && !coinActive) {
        coinActive = true; isFlipping = false; showResult = false;
      } else if (currentScreen == SCREEN_STOPWATCH) {
        if (!swActive) { swActive = true; swRunning = false; swElapsedTime = 0; }
        else if (!swRunning) { swElapsedTime = 0; } // Reset Stopwatch
      } else if (currentScreen == SCREEN_TEXT && !textActive) {
        textActive = true; currentTextLine = 0; loadTextLines(0); lastTextScrollTime = currentMillis;
      }
    } else if (clickCount == 1) {
      // --- SINGLE CLICK EVENT ---
      if (isEditingAOD) {
        isAODEnabled = !isAODEnabled; 
      } else if (!isWiFiActive) {
        if (currentScreen == SCREEN_GAME && gameActive) {
          if (gameOver) { gameOver = false; score = 0; cactusX = 128; dinoY = 38; dinoVy = 0; } 
          else if (dinoY >= 38) { dinoVy = jumpStrength; }
        } else if (currentScreen == SCREEN_COIN && coinActive) {
          if (!isFlipping) { isFlipping = true; showResult = false; flipStartTime = currentMillis; }
        } else if (currentScreen == SCREEN_STOPWATCH && swActive) {
          if (swRunning) { 
            swRunning = false; 
            swElapsedTime += (lastButtonReleaseTime - swStartTime); 
          } else { 
            swRunning = true; 
            swStartTime = lastButtonReleaseTime; 
          }
        } else if (currentScreen == SCREEN_TEXT && textActive) {
           currentTextLine++; loadTextLines(currentTextLine); lastTextScrollTime = currentMillis;
        } else {
          // Cycle through all 10 screens
          currentScreen = (ScreenState)(((int)currentScreen + 1) % 10); 
          gameActive = false; coinActive = false; swActive = false; textActive = false;
        }
      }
    }
    clickCount = 0;
  }

  if ((currentMillis - lastActivityTime >= displayTimeoutMs) && !isWiFiActive && !swRunning && !isFlipping) {
    
    isEditingAOD = false; 
    showDoneMessage = false;

    if (isAODEnabled) {
      if (!isScreenDimmed) {
        setOLEDContrast(aodBrightness); 
        isScreenDimmed = true;
      }

      static unsigned long lastAODDraw = 0;
      if (currentMillis - lastAODDraw >= 1000) {
        u8g2.clearBuffer();
        u8g2.setFont(u8g2_font_logisoso46_tn); 
        struct tm timeinfo; getLocalTime(&timeinfo);
        
        char hrBuf[4], minBuf[4];
        snprintf(hrBuf, sizeof(hrBuf), "%02d", timeinfo.tm_hour);
        snprintf(minBuf, sizeof(minBuf), "%02d", timeinfo.tm_min);
        
        u8g2.drawStr(-6, 58, hrBuf);
        u8g2.drawStr(60, 58, minBuf);
        u8g2.drawStr(43, 54, ":");
        
        u8g2.sendBuffer();
        lastAODDraw = currentMillis;
      }
      
    } else {
      u8g2.setPowerSave(1); 
      currentScreen = SCREEN_HOME; 
      esp_deep_sleep_start(); 
    }
    
  } else {
    renderUI();
  }
}
